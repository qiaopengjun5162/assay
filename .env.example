# 查询后端（crates/api）的本地环境变量清单。
#
# 注意：项目**没有**引入 dotenvy，`.env` 不会被自动读取。要让它生效：
#   set -a; . ./.env; set +a; just api
# 或者把变量直接写在命令前面：
#   DATABASE_URL=postgres://... just api-ingest 2026-11-18
#
# 不需要这个服务也能跑完整流水线：audit → export → web 全是静态的。
DATABASE_URL=postgres://assay:assay@127.0.0.1:5432/assay
PORT=8081
RUST_LOG=assay_api=info,tower_http=info
